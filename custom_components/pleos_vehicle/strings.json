{
  "title": "Pleos Vehicle Data",
  "config": {
    "step": {
      "user": {
        "title": "Pleos Vehicle Data",
        "description": "Choose your car's brand, then enter the Client ID and Client Secret of your My Vehicle API key from the Pleos Playground. The integration is read-only.",
        "data": {
          "brand": "Brand",
          "client_id": "Client ID",
          "client_secret": "Client secret",
          "tank_capacity": "Fuel tank capacity",
          "battery_capacity": "Battery capacity"
        },
        "data_description": {
          "tank_capacity": "Used to work out fuel economy. 42 L is the figure for the NX4 Tucson plug-in hybrid; adjust it for your car.",
          "battery_capacity": "Used to work out electric economy. 60 kWh is a typical mid-size pure-EV battery; adjust it for your car."
        }
      },
      "reauth_confirm": {
        "title": "Pleos Vehicle Data - Credentials",
        "description": "Pleos rejected the stored credentials. Enter the Client ID and Client Secret again.",
        "data": {
          "client_id": "Client ID",
          "client_secret": "Client secret"
        }
      }
    },
    "error": {
      "invalid_auth": "Client ID or client secret rejected.",
      "cannot_connect": "Could not reach the Pleos API.",
      "no_vehicles": "No vehicles are shared with this API key."
    },
    "abort": {
      "already_configured": "This API key is already configured.",
      "reauth_successful": "Credentials updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Pleos Vehicle Data",
        "description": "Change how the Pleos data is interpreted. The integration stays read-only.",
        "data": {
          "tank_capacity": "Fuel tank capacity",
          "battery_capacity": "Battery capacity"
        },
        "data_description": {
          "tank_capacity": "Used to work out fuel economy, because Pleos reports the fuel level as a percentage and never reports litres burned.",
          "battery_capacity": "Used to work out electric economy, because Pleos reports the battery state of charge as a percentage and never reports kilowatt-hours used."
        }
      }
    }
  },
  "services": {
    "refresh": {
      "name": "Refresh vehicle data",
      "description": "Fetches the latest vehicle data from Pleos now instead of waiting for the next scheduled update. Pleos only returns what the car last uploaded."
    }
  },
